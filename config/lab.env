# ============================================================================
# k8s-lab — single source of truth for the whole lab.
# Sourced by every script and by labctl. Change values BEFORE first bring-up;
# changing addressing/nodes later requires `./labctl destroy` and a rebuild.
# ============================================================================

LAB_NAME="k8slab"
LAB_DOMAIN="k8s.lab"

# ---------------------------------------------------------------------------
# Virtual networks (the "rack" fabric)
#   mgmt    = NAT'd management/OOB network: SSH, apt, image pulls (internet)
#   cluster = routed data network: ALL Kubernetes traffic (API, etcd, VXLAN,
#             LoadBalancer VIPs). Routed (not NAT) so the host — and, with a
#             static route, other LAN devices — can reach it directly.
# ---------------------------------------------------------------------------
MGMT_NET="k8s-mgmt"
MGMT_BR="virbr-k8smg"
MGMT_CIDR="10.10.0.0/24"
MGMT_GW="10.10.0.1"
MGMT_DHCP_START="10.10.0.150"   # for ad-hoc extra VMs; lab nodes use static IPs
MGMT_DHCP_END="10.10.0.199"

CLUSTER_NET="k8s-cluster"
CLUSTER_BR="virbr-k8scl"
CLUSTER_CIDR="10.20.0.0/24"
CLUSTER_HOST_IP="10.20.0.1"     # host-side bridge IP (acts as the "core router")

# ---------------------------------------------------------------------------
# Kubernetes addressing
# ---------------------------------------------------------------------------
API_VIP="10.20.0.100"           # kube-vip floating VIP for the HA API server
API_FQDN="api.k8s.lab"          # resolves to API_VIP (libvirt DNS + /etc/hosts)
GATEWAY_IP="10.20.0.200"        # pinned LoadBalancer IP of the shared Gateway
LB_POOL_START="10.20.0.200"     # Cilium LB-IPAM pool (Gateway takes .200)
LB_POOL_STOP="10.20.0.239"
POD_CIDR="10.244.0.0/16"        # Cilium cluster-pool IPAM, /24 per node
SVC_CIDR="10.96.0.0/16"

# ---------------------------------------------------------------------------
# Nodes — 3 control planes (stacked etcd, quorum=2) + 3 workers
# IP convention: octet .1X = control plane N, .2X = worker N, on BOTH networks
#   cp1 10.10.0.11/10.20.0.11   w1 10.10.0.21/10.20.0.21   etc.
# ---------------------------------------------------------------------------
CP_NODES="cp1 cp2 cp3"
WORKER_NODES="w1 w2 w3"
CP_VCPUS=2;  CP_RAM_MB=4096; CP_DISK_GB=30
W_VCPUS=4;   W_RAM_MB=8192;  W_DISK_GB=60
VM_PREFIX="k8s"                 # libvirt domain names: k8s-cp1, k8s-w1, ...
VM_POOL="k8slab"                # libvirt storage pool
VM_POOL_DIR="/var/lib/libvirt/images/k8slab"
SSH_USER="ops"
SSH_KEY="$HOME/.ssh/k8s-lab"

# ---------------------------------------------------------------------------
# Pinned versions — see README "Version policy" for the reasoning.
# ---------------------------------------------------------------------------
K8S_MINOR="v1.35"               # pkgs.k8s.io train (n-1 of upstream stable 1.36)
UBUNTU_IMG_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
UBUNTU_IMG="noble-server-cloudimg-amd64.img"
CILIUM_VERSION="1.19.6"         # n-1 train (1.20.0 is a fresh .0 release)
GATEWAY_API_VERSION="v1.4.1"    # exactly what Cilium 1.19 supports
KUBE_VIP_VERSION="v1.2.2"
CERT_MANAGER_VERSION="v1.21.1"
LOCAL_PATH_VERSION="v0.0.37"
CILIUM_CLI_VERSION="v0.19.7"
HUBBLE_CLI_VERSION="v1.19.4"
K9S_VERSION="v0.51.0"
PODINFO_VERSION="6.14.1"
PAUSE_IMAGE="registry.k8s.io/pause:3.10"
